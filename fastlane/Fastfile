default_platform(:ios)

platform :ios do
  desc "Build and deploy signed iOS app directly to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APP_STORE_CONNECT_KEY_ID']}.p8")
    )

    setup_ci

    # 1. Automatically fetch or create Distribution Certificate via Apple REST API
    get_certificates(
      api_key: api_key,
      type: "distribution"
    )

    # 2. Automatically fetch or create App Store Provisioning Profile
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.astarswimschools.parent"
    )

    # 3. Build & sign production IPA
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "AStarSwimSchools-Production.ipa",
      clean: true
    )

    # 4. Upload signed IPA to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      ipa: "./build/AStarSwimSchools-Production.ipa"
    )
  end
end
